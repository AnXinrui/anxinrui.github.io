---
import type { CollectionEntry } from "astro:content";
import path from "node:path";
import { formatDateTime } from "../utils/date-utils";
import { getDir } from "../utils/url-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
import Markdown from "./misc/Markdown.astro";
import SecretMomentCard from "./SecretMomentCard.svelte";

interface Props {
	entry: CollectionEntry<"moments">;
	class?: string;
	style?: string;
}

const { entry, style } = Astro.props;
const className = Astro.props.class;

const isSecret = entry.data.secret === true;
const images = isSecret ? [] : (entry.data.images ?? []);
const imageBasePath = path.join("content/moments/", getDir(entry.id));

// 加密条目不在服务端渲染 Markdown，密文直接交给客户端组件解密
const content = isSecret ? (entry.body ?? "").trim() : null;
const { Content } = await entry.render();
---

<article class:list={["card-base px-6 py-5 md:px-8 md:py-6", className]} style={style}>
	<time class="text-sm text-50 mb-3 block" datetime={entry.data.published.toISOString()}>
		{formatDateTime(entry.data.published)}
	</time>

	{isSecret ? (
		content && content.length > 0 ? (
			<SecretMomentCard client:only="svelte" ciphertext={content} />
		) : (
			<p class="text-50 text-sm mb-4">这条碎碎念的密文缺失，请重新运行 pnpm encrypt-moments</p>
		)
	) : (
		<Markdown class="mb-4 markdown-content">
			<Content />
		</Markdown>
	)}

	{images.length > 0 && (
		<div
			class:list={[
				"moment-gallery grid gap-1.5",
				images.length === 1 && "grid-cols-1 max-w-[11rem]",
				images.length === 2 && "grid-cols-2 max-w-[14rem]",
				images.length >= 3 && "grid-cols-3 max-w-[14rem]",
			]}
		>
			{images.map((src) => (
				<div class="rounded-lg overflow-hidden aspect-square">
					<ImageWrapper
						src={src}
						basePath={imageBasePath}
						alt=""
						class="w-full h-full"
					/>
				</div>
			))}
		</div>
	)}
</article>
